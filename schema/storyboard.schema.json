{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["title", "language", "aspect_ratios", "style_anchor", "shots"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2 },
    "aspect_ratios": {
      "type": "array",
      "items": { "type": "string", "enum": ["16:9", "9:16"] },
      "minItems": 2
    },
    "style_anchor": { "type": "string", "minLength": 5 },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "duration_sec",
          "reason",
          "narration",
          "subtitle_en",
          "image_prompt",
          "motion_prompt",
          "seed"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "duration_sec": { "type": "number", "minimum": 3, "maximum": 20 },
          "reason": { "type": "string", "minLength": 3 },
          "narration": { "type": "string", "minLength": 1 },
          "subtitle_en": { "type": "string", "minLength": 1 },
          "image_prompt": { "type": "string", "minLength": 5 },
          "motion_prompt": { "type": "string", "minLength": 3 },
          "seed": { "type": "integer" }
        }
      }
    }
  }
}
